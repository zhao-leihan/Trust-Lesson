generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  walletAddress String?   @unique
  passwordHash  String?
  role          String    @default("LEARNER") // "LEARNER" | "MENTOR" | "ADMIN"
  name          String?
  email         String?   @unique
  university    String?
  avatarUrl     String?
  bio           String?
  domain        String?
  linkedin      String?
  instagram     String?
  twitter       String?
  portfolio     String?
  hourlyRate    Float     @default(35)
  stakeAmount   Float     @default(0)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessionsAsLearner Session[]      @relation("LearnerSessions")
  sessionsAsMentor  Session[]      @relation("MentorSessions")
  videos            Video[]
  disputes          Dispute[]
  videoPurchases    VideoPurchase[]
}

model Offering {
  id            String   @id @default(uuid())
  offeringType  String   // "mentor" | "course"
  title         String
  category      String   // "Coding", "Career", "Design", "Business", "Languages", "Music"
  price         Float    @default(0)
  duration      String   // "1 hour", "4 Weeks (4 Milestones)"
  rating        Float    @default(5.0)
  sessionsCount Int      @default(0)
  reputation    Int      @default(95)
  level         String   @default("All levels")
  description   String
  coverImage    String
  mentorName    String
  mentorPhoto   String
  mentorAddress String?
  verified      Boolean  @default(true)
  milestones    String?  // JSON serialized milestones array
  deliverables  String?  // JSON serialized deliverables array
  createdAt     DateTime @default(now())
}

model Resource {
  id        String   @id @default(uuid())
  title     String
  author    String
  icon      String   @default("BookOpen")
  color     String   @default("#EFF6FF")
  url       String?
  createdAt DateTime @default(now())
}

model Session {
  id            String    @id @default(uuid())
  onChainId     BigInt?   @unique
  learnerId     String
  mentorId      String
  status        String    @default("CREATED") // "CREATED" | "FUNDED" | "IN_SESSION" | "COMPLETED" | "DISPUTED" | "RESOLVED" | "CANCELLED"
  tokenAddress  String    @default("0xaf88d065e77c8cC2239327C5EDb3A432268e5831")
  totalAmount   Float
  txHashCreate  String?
  txHashRelease String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  learner    User        @relation("LearnerSessions", fields: [learnerId], references: [id])
  mentor     User        @relation("MentorSessions", fields: [mentorId], references: [id])
  milestones Milestone[]
  dispute    Dispute?
}

model Milestone {
  id          String    @id @default(uuid())
  sessionId   String
  index       Int
  title       String
  amount      Float
  deadline    DateTime?
  status      String    @default("LOCKED") // "LOCKED" | "RELEASED" | "DISPUTED" | "REFUNDED"
  evidenceUrl String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Video {
  id           String   @id @default(uuid())
  mentorId     String
  title        String
  description  String?
  cloudflareId String
  contentHash  String
  priceUsdc    Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  mentor    User            @relation(fields: [mentorId], references: [id])
  purchases VideoPurchase[]
}

model VideoPurchase {
  id        String   @id @default(uuid())
  videoId   String
  learnerId String
  txHash    String
  createdAt DateTime @default(now())

  video   Video @relation(fields: [videoId], references: [id])
  learner User  @relation(fields: [learnerId], references: [id])

  @@unique([videoId, learnerId])
}

model Dispute {
  id           String    @id @default(uuid())
  sessionId    String    @unique
  raisedById   String
  reason       String
  evidenceHash String
  status       String    @default("OPEN") // "OPEN" | "UNDER_REVIEW" | "RESOLVED"
  resolution   String?
  resolvedAt   DateTime?

  session  Session @relation(fields: [sessionId], references: [id])
  raisedBy User    @relation(fields: [raisedById], references: [id])
}

model AuthNonce {
  id        String   @id @default(uuid())
  address   String   @unique
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

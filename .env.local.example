# ==============================================================================
# TRUST LESSON — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local or .env and fill in real values
# ==============================================================================

# === DATABASE ENGINE ===
DATABASE_URL="file:./trust_lesson.db"

# === AUTHENTICATION & SECURITY SECRETS ===
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="GENERATE_VIA_CRYPTO_RANDOM_HEX_64_CHARS"
JWT_EXPIRES_IN="7d"

# === NETWORK MASTER SWITCHER: "testnet" | "mainnet" | "local" ===
NEXT_PUBLIC_APP_NETWORK="testnet"

# === PLATFORM GAS SUBSIDY & SPONSOR RELAYER WALLET ===
# The dedicated platform sponsor vault that absorbs 100% of L2 gas fees for learners and mentors
PLATFORM_SPONSOR_WALLET=""
NEXT_PUBLIC_PLATFORM_SPONSOR_WALLET=""
PLATFORM_SPONSOR_PRIVATE_KEY=""

# === PLATFORM TREASURY & PROTOCOL REVENUE WALLET ===
